{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "vinidourado.vercel.app" }],
      "destination": "https://www.douradostudio.dev.br/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "douradostudio.dev.br" }],
      "destination": "https://www.douradostudio.dev.br/:path",
      "permanent": true
    },
    { "source": "/orcamento", "destination": "/servicos", "permanent": true },
    { "source": "/projects", "destination": "/projetos", "permanent": true },
    { "source": "/projects/:slug", "destination": "/projetos/:slug", "permanent": true },
    { "source": "/servicos/pagina-de-curso-ou-evento", "destination": "/servicos/landing-page-de-campanha", "permanent": true },
    { "source": "/servicos/sistema-sob-medida", "destination": "/servicos/automacao-e-integracao", "permanent": true }
  ]
}
